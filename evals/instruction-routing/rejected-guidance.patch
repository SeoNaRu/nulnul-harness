+def reachable_skill_documents(root):
+    """Follow packaged Markdown routes, without making users load them together."""
+    pending = [root / "SKILL.md"]
+    documents = {}
+    while pending:
+        path = pending.pop()
+        if path in documents:
+            continue
+        text = path.read_text(encoding="utf-8")
+        documents[path] = text
+        links = re.findall(r"\[[^\]]*\]\(([^)#]+\.md)(?:#[^)]*)?\)|`([^`\n]+\.md)`", text)
+        for markdown, code in links:
+            target = markdown or code
+            if "://" in target:
+                continue
+            candidates = [path.parent / target, root / target]
+            resolved = next((item.resolve() for item in candidates if item.is_file()), None)
+            if resolved is not None and resolved.is_relative_to(root.resolve()):
+                if resolved not in documents:
+                    pending.append(resolved)
+            elif target.startswith(("references/", "../references/")):
+                raise ValueError(f"Missing packaged reference: {target}")
+    return documents
 
 
