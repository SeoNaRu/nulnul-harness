{
  "schema_version": 1,
  "evaluation_kind": "deterministic-decision-contract",
  "claim_boundary": "These cases verify NULNUL's capability-selection contract. They do not measure model task performance, estimate universal quality, or prove that an external capability is better without task-specific evidence.",
  "decision_order": [
    "maximize_expected_verified_outcome_quality",
    "respect_user_safety_permission_cost_compatibility_and_reproducibility_constraints",
    "break_materially_equivalent_ties_by_lower_waste"
