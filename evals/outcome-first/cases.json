      "category": "quality-over-size",
      "evidence": "Direct execution misses a reproduced security defect; a specialized capability plus independent review fixes it and passes both checks at proportionate cost.",
      "paths": {
        "direct": {
          "outcome": "materially_weaker",
          "verification": "misses_reproduced_defect",
          "added_capabilities": 0,
          "total_cost": "lower"
        },
        "specialized-reviewed": {
          "outcome": "materially_better",
          "verification": "passes_completion_and_independent_review",
          "added_capabilities": 2,
          "total_cost": "proportionate"
        }
      },
      "expected_path": "specialized-reviewed",
      "expected_action": "SELECT",
      "expected_validation": "PASS"
    },
    {
      "id": "same-quality-less-complexity-wins",
      "category": "simplicity-tie-breaker",
      "evidence": "Both paths pass the same completion and regression checks with materially equivalent quality; the two-capability path has lower context and coordination cost.",
      "paths": {
        "focused-two": {
          "outcome": "materially_equivalent",
          "verification": "passes_all_checks",
          "added_capabilities": 2,
          "total_cost": "lower"
        },
        "broad-seven": {
          "outcome": "materially_equivalent",
          "verification": "passes_all_checks",
          "added_capabilities": 7,
          "total_cost": "higher"
        }
      },
      "expected_path": "focused-two",
      "expected_action": "SELECT",
      "expected_validation": "PASS"
    },
    {
