{
  "schema_version": 1,
  "guarded_kernel": [
    {
      "invariant_id": "stable-identity",
      "behavior": "Runtime-generated Session, Task, Pack, Check, Experience, Decision, Agent, topology, candidate, and control identities remain deterministic or collision-resistant and are never model-owned.",
      "implementation_refs": ["foundation_runtime.py identity helpers", "capability_pack.py pack identity", "lifecycle transaction validators"],
      "validator": "reject malformed, duplicate, mismatched, or model-supplied runtime identities"
    },
    {
      "invariant_id": "provenance-integrity",
      "behavior": "Every promoted outcome keeps validated source, derivation, and supersession lineage.",
      "implementation_refs": ["foundation_runtime.py validate_lineage", "memory/decisions.jsonl"],
      "validator": "reject dangling, cyclic, self-referential, or rewritten lineage"
    },
    {
      "invariant_id": "atomic-single-writer",
      "behavior": "One project writer owns durable state changes and all owned mutations commit atomically.",
      "implementation_refs": ["foundation_runtime.py writer", "sync_host_entry.py atomic_batch_write"],
      "validator": "reject concurrent ownership and partial batch writes"
    },
    {
      "invariant_id": "rollback",
      "behavior": "Failed lifecycle transactions restore every transaction-owned byte.",
      "implementation_refs": ["Natural Selection, External Competition, Agent Evolution, and Harness Evolution transactions"],
      "validator": "negative-control replacement failure reconstructs the Champion exactly"
    },
    {
      "invariant_id": "evidence-integrity",
      "behavior": "Only active verified observable evidence may authorize evolution; raw chat and hidden reasoning cannot.",
      "implementation_refs": ["foundation_runtime.py Experience eligibility", "Evolution Input queries"],
      "validator": "reject unverified, inactive, unattributed, fabricated, or missing evidence"
    },
    {
      "invariant_id": "raw-transcript-privacy",
      "behavior": "Raw transcripts stay local-only and never enter durable Memory, Context Packs, or Evolution Input.",
      "implementation_refs": ["docs/nulnul/.runtime/raw", "foundation_runtime.py context_pack"],
      "validator": "raw transcript negative controls remain excluded"
    },
    {
      "invariant_id": "authority-separation",
      "behavior": "Capability, Agent, and Harness policy context never grants structural authority or mutates host trust.",
      "implementation_refs": ["Capability Pack", "Agent contract authority boundary", "Governed transaction authority"],
      "validator": "reject authority broadening, trust mutation, or unauthorized writes"
    },
    {
      "invariant_id": "lifecycle-history",
      "behavior": "Superseded and retired versions retain immutable history and version-bound evidence.",
      "implementation_refs": ["memory lifecycle", "capability, topology, and control archives"],
      "validator": "reject destructive history rewrite or missing supersession lineage"
    },
    {
      "invariant_id": "check-receipt-integrity",
      "behavior": "Deterministic authoritative checks, not model-authored success, own verification receipts.",
      "implementation_refs": ["capability_pack.py finalize_pack_task", "foundation_runtime.py eligibility"],
      "validator": "reject missing, mismatched, forged, or disabled authoritative Check receipts"
    },
    {
      "invariant_id": "champion-challenger-separation",
      "behavior": "The frozen current control remains active until one distinct frozen Challenger wins validation.",
      "implementation_refs": ["Harness Challenger and competition receipts"],
      "validator": "reject in-place mutation, second Challenger, stale Champion, or post-freeze edits"
    },
    {
      "invariant_id": "deterministic-promotion",
      "behavior": "A Challenger cannot edit its evidence, competition, Decision, current status, or promotion outcome.",
      "implementation_refs": ["Harness safety gate", "Harness control transaction"],
      "validator": "only the deterministic transaction may mark a validated winner current"
    },
    {
      "invariant_id": "bounded-context-hard-limits",
      "behavior": "Ordinary Context remains at most eight items and 4096 serialized bytes, with raw and retired content excluded.",
      "implementation_refs": ["foundation_runtime.py MAX_CONTEXT_ITEMS", "foundation_runtime.py MAX_CONTEXT_BYTES"],
      "validator": "ranking policy may vary only inside immutable hard maximums"
    }
  ],
  "kernel_digest": "9505d00d66799a56c0c77b6ff35978c9d7815b0dcd795bdbab6af5a1291d739e",
  "controls": [
